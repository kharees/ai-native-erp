# ==============================================================================
#  AI-Native ERP — Frontend Environment Variables
#  File: frontend/.env.example
#
#  INSTRUCTIONS:
#    1. Copy this file:  cp .env.example .env.local
#    2. Fill in ALL values marked <REPLACE_ME> before running the dev server.
#    3. Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
#       Never put secrets in NEXT_PUBLIC_ variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Identity
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI-Native ERP"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# ------------------------------------------------------------------------------
# Backend API
# ------------------------------------------------------------------------------
# Base URL of the FastAPI backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Supabase — Browser / Public Client
# These are SAFE to expose to the browser (protected by Row-Level Security).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=<REPLACE_ME>             # e.g. https://xyzabc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<REPLACE_ME>        # Found in Project Settings → API

# ------------------------------------------------------------------------------
# Supabase — Server-Side Only (never expose these to the browser)
# Used by Next.js Server Components / Route Handlers only.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_ME>            # High-privilege key — keep secret!

# ------------------------------------------------------------------------------
# Authentication
# ------------------------------------------------------------------------------
NEXTAUTH_SECRET=<REPLACE_ME>                      # Generate: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Feature Flags (optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_AI_COPILOT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false
