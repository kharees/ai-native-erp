# ==============================================================================
#  AI-Native ERP — Backend Environment Variables
#  File: backend/.env.example
#
#  INSTRUCTIONS:
#    1. Copy this file:  cp .env.example .env
#    2. Fill in ALL values marked <REPLACE_ME> before starting the server.
#    3. NEVER commit the filled-in .env file — it is listed in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application
# ------------------------------------------------------------------------------
APP_NAME="AI-Native ERP API"
APP_VERSION="0.1.0"
ENVIRONMENT=development                  # development | staging | production
DEBUG=true

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
SECRET_KEY=<REPLACE_ME>                  # Generate: openssl rand -hex 32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=<REPLACE_ME>               # e.g. https://xyzabc.supabase.co
SUPABASE_ANON_KEY=<REPLACE_ME>          # Project Settings → API → anon / public
SUPABASE_SERVICE_ROLE_KEY=<REPLACE_ME>  # Project Settings → API → service_role (SECRET)

# ------------------------------------------------------------------------------
# Database — Direct Postgres (for SQLAlchemy / Alembic migrations)
# Supabase provides this under Project Settings → Database → Connection string
# Use the "asyncpg" driver prefix for async SQLAlchemy.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASS>@<DB_HOST>:5432/<DB_NAME>

# ------------------------------------------------------------------------------
# Connection Pool Tuning (asyncpg / SQLAlchemy)
# ------------------------------------------------------------------------------
DB_POOL_SIZE=10                          # persistent connections per process
DB_MAX_OVERFLOW=20                       # burst connections beyond pool_size
DB_POOL_TIMEOUT=30                       # seconds to wait for a free connection
DB_POOL_RECYCLE=1800                     # recycle connections after N seconds

# ------------------------------------------------------------------------------
# CORS / Trusted Hosts
# Comma-separated list of allowed origins / hosts
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# AI / LLM Providers
# ------------------------------------------------------------------------------
OPENAI_API_KEY=<REPLACE_ME>             # https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=<REPLACE_ME>          # https://console.anthropic.com/settings/keys

# ------------------------------------------------------------------------------
# Redis / Celery Task Queue
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Observability — Sentry (optional)
# ------------------------------------------------------------------------------
SENTRY_DSN=<REPLACE_ME>                 # Leave empty to disable Sentry reporting
